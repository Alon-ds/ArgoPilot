# Free tier, no API key required. For paid use, configure customer endpoint and key.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=
# Match planner-service's timezone so both services agree on "today".
FORECAST_TIMEZONE=Asia/Jerusalem
PROVIDER_TIMEOUT_SECONDS=5
# Retries after the first attempt (2 means 3 total attempts).
PROVIDER_RETRIES=2
CACHE_FRESHNESS_SECONDS=10800
# Total age since successful fetch, including the fresh period.
STALE_MAX_AGE_SECONDS=86400
RETRY_AFTER_SECONDS=60
